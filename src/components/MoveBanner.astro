---
// Annonce le déménagement de docs.kotbo.fr vers kotbo.fr/docs ; se ferme et ne revient plus.
const en = Astro.currentLocale === 'en';
---

<div class="move-banner" hidden>
  <p>
    {
      en ? (
        <>The docs now live at <strong>kotbo.fr/docs</strong> (previously docs.kotbo.fr). Old links redirect automatically.</>
      ) : (
        <>La documentation est désormais sur <strong>kotbo.fr/docs</strong> (anciennement docs.kotbo.fr). Les anciens liens redirigent automatiquement.</>
      )
    }
  </p>
  <button type="button" aria-label={en ? 'Close' : 'Fermer'}>×</button>
</div>

<style>
  .move-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }
  .move-banner[hidden] {
    display: none;
  }
  p {
    margin: 0;
  }
  button {
    background: none;
    border: 0;
    color: inherit;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'kotbo-docs-move-banner';
    var el = document.querySelector('.move-banner');
    var seen = false;
    try { seen = localStorage.getItem(KEY) === '1'; } catch (e) {}
    if (!el || seen) return;
    el.hidden = false;
    el.querySelector('button').addEventListener('click', function () {
      el.hidden = true;
      try { localStorage.setItem(KEY, '1'); } catch (e) {}
    });
  })();
</script>
