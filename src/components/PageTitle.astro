---
// Titre de Starlight, suivi d'un bandeau quand la page relève de l'offre Plus.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { planOf } from '../plans.mjs';

const route = Astro.locals.starlightRoute;
const plan = planOf(route.id);
const isEnglish = route.locale === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const billing = `${base}/${isEnglish ? 'en/' : ''}dashboard/configuration/facturation/`;

const text = {
  plus: isEnglish
    ? { title: 'Plus plan', body: 'This feature is part of the Plus plan: €5 a month or €30 a year, the same price for every server.' }
    : { title: 'Offre Plus', body: 'Cette fonctionnalité fait partie de l’offre Plus : 5 € par mois ou 30 € par an, au même prix pour tous les serveurs.' },
  freemium: isEnglish
    ? { title: 'Free, fuller with Plus', body: 'The essentials are free. The Plus plan lifts the limits described on this page.' }
    : { title: 'Gratuit, plus complet avec Plus', body: 'L’essentiel est gratuit. L’offre Plus lève les limites décrites sur cette page.' },
};
const link = isEnglish ? 'See the plans' : 'Voir les offres';
---

<Default />
{plan && (
  <aside class={`plan-banner plan-banner--${plan}`}>
    <span class="plan-banner__crown" aria-hidden="true">👑</span>
    <p>
      <strong>{text[plan].title}.</strong> {text[plan].body} <a href={billing}>{link}</a>
    </p>
  </aside>
)}

<style>
  .plan-banner {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-warning) 45%, transparent);
    background: color-mix(in srgb, var(--color-warning) 10%, transparent);
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }
  .plan-banner--freemium {
    border-color: var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
  }
  .plan-banner p { margin: 0; }
  .plan-banner__crown { font-size: 1.1rem; line-height: 1.4; }
  .plan-banner--freemium .plan-banner__crown { opacity: 0.55; filter: grayscale(0.6); }
</style>
