---
// Le site est servi sous `base` (/docs) : on travaille sur le chemin sans, puis on le remet.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.slice(base.length) || '/';
const isEnglish = pathname === '/en' || pathname.startsWith('/en/');
const rootPath = isEnglish ? pathname.replace(/^\/en(?=\/|$)/, '') || '/' : pathname;

const languages = [
  { code: 'fr', short: 'FR', label: 'Français', href: `${base}${rootPath}` },
  { code: 'en', short: 'EN', label: 'English', href: `${base}${rootPath === '/' ? '/en/' : `/en${rootPath}`}` },
];

const activeCode = isEnglish ? 'en' : 'fr';
const current = languages.find((language) => language.code === activeCode) ?? languages[0];
const switchLabel = isEnglish ? 'Change language' : 'Changer de langue';
---

<div class="lang-menu">
  <button
    type="button"
    class="lang-menu__trigger"
    title={switchLabel}
    aria-label={switchLabel}
    aria-haspopup="listbox"
    aria-expanded="false"
  >
    <span aria-hidden="true">{current.short}</span>
  </button>

  <div class="lang-menu__panel" role="listbox" aria-label={switchLabel} hidden>
    {
      languages.map((language) => (
        <a
          role="option"
          href={language.href}
          hreflang={language.code}
          aria-selected={language.code === activeCode ? 'true' : 'false'}
          class:list={['lang-menu__option', { 'lang-menu__option--active': language.code === activeCode }]}
        >
          <span class="lang-menu__code" aria-hidden="true">{language.short}</span>
          <span class="lang-menu__label">{language.label}</span>
          {language.code === activeCode && (
            <svg
              class="lang-menu__check"
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20 6 9 17l-5-5" />
            </svg>
          )}
        </a>
      ))
    }
  </div>
</div>

<style>
  .lang-menu {
    position: relative;
    display: flex;
    align-items: center;
  }

  .lang-menu__trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    cursor: pointer;
    user-select: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .lang-menu__trigger:hover {
    background: var(--sl-color-gray-6);
    border-color: var(--sl-color-gray-4);
  }

  .lang-menu__trigger:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .lang-menu__panel {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.5rem);
    z-index: 50;
    min-width: 10rem;
    padding: 0.25rem 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-black);
    box-shadow: 0 10px 30px rgba(2, 12, 27, 0.18);
  }

  .lang-menu__panel[hidden] {
    display: none;
  }

  /* In the mobile menu the switcher sits at the bottom of the nav panel,
     so the list has to open upwards or it gets clipped off-screen. */
  :global(.mobile-preferences) .lang-menu__panel {
    top: auto;
    bottom: calc(100% + 0.5rem);
  }

  .lang-menu__option {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.75rem;
    color: var(--sl-color-white);
    font-size: 0.875rem;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .lang-menu__option:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .lang-menu__option--active {
    background: var(--sl-color-gray-6);
    font-weight: 600;
  }

  .lang-menu__code {
    min-width: 1.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--sl-color-gray-2);
  }

  .lang-menu__option--active .lang-menu__code {
    color: var(--sl-color-white);
  }

  .lang-menu__label {
    flex: 1;
  }

  .lang-menu__check {
    color: var(--sl-color-accent);
  }
</style>

<script>
  function setupLanguageMenu() {
    document.querySelectorAll<HTMLElement>('.lang-menu').forEach((menu) => {
      if (menu.dataset.ready === 'true') return;
      menu.dataset.ready = 'true';

      const trigger = menu.querySelector<HTMLButtonElement>('.lang-menu__trigger');
      const panel = menu.querySelector<HTMLElement>('.lang-menu__panel');
      if (!trigger || !panel) return;

      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        const willOpen = panel.hidden;
        closeAllMenus();
        panel.hidden = !willOpen;
        trigger.setAttribute('aria-expanded', String(willOpen));
      });
    });
  }

  function closeMenu(menu: Element) {
    const panel = menu.querySelector<HTMLElement>('.lang-menu__panel');
    const trigger = menu.querySelector<HTMLElement>('.lang-menu__trigger');
    if (panel) panel.hidden = true;
    if (trigger) trigger.setAttribute('aria-expanded', 'false');
  }

  function closeAllMenus() {
    document.querySelectorAll('.lang-menu').forEach(closeMenu);
  }

  // Registered once at module scope: Starlight renders this component twice
  // (desktop header + mobile menu) and setup re-runs on every navigation, so
  // per-menu document listeners would pile up on detached nodes.
  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    document.querySelectorAll('.lang-menu').forEach((menu) => {
      if (!menu.contains(target)) closeMenu(menu);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAllMenus();
  });

  setupLanguageMenu();
  document.addEventListener('astro:after-swap', setupLanguageMenu);
</script>
